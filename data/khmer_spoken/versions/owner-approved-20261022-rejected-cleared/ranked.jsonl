{"id": "kp-050", "source": "Venerable, please bless my family.", "target": "ព្រះគុណម្ចាស់ សូមមេត្តាឱ្យពរជ័យដល់ក្រុមគ្រួសារករុណាផង។", "license_type": "unknown", "review_status": "approved", "from_jev": true}
{"id": "kp-051", "source": "Venerable, have you eaten?", "target": "តេជគុណ ឆាន់បាយហើយនៅ?", "license_type": "unknown", "review_status": "approved", "from_jev": true}
{"id": "kp-052", "source": "I'd like to offer food.", "target": "ករុណាព្រះគុណម្ចាស់ យាយមានសទ្ធាចង់ប្រគេនចង្ហាន់។", "license_type": "unknown", "review_status": "approved", "from_jev": true}
{"id": "kp-053", "source": "Thank you, Venerable.", "target": "អរព្រះគុណ ព្រះតេជគុណ។", "license_type": "unknown", "review_status": "approved", "from_jev": true}
{"id": "kp-054", "source": "May you be happy.", "target": "សូមឱ្យញោមជួបតែសេចក្តីសុខណា។", "license_type": "unknown", "review_status": "approved", "from_jev": true}
{"id": "kp-055", "source": "I will chant for you tomorrow.", "target": "ស្អែក អាត្មាចាំសូត្រមន្តឱ្យញោម។", "license_type": "unknown", "review_status": "approved", "from_jev": true}
{"id": "kp-056", "source": "Child, do not be angry.", "target": "កូន កុំខឹងអី។", "license_type": "unknown", "review_status": "approved", "from_jev": true}
{"id": "kp-058", "source": "Grandma, let me help you.", "target": "លោកយាយ ទុកឱ្យចៅជួយណា៎។", "license_type": "unknown", "review_status": "approved", "from_jev": true}
