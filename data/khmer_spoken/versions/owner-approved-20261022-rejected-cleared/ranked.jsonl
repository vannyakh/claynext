{"id": "kp-008", "source": "Dad is proud of you.", "target": "ប៉ាមានមោទនភាពចំពោះកូនណាស់។", "license_type": "unknown", "review_status": "approved", "from_jev": true}
{"id": "kp-009", "source": "Where have you been all night?", "target": "មួយយប់ទល់ភ្លឺហ្នឹង ឯងទៅណាមក?", "license_type": "unknown", "review_status": "approved", "from_jev": true}
